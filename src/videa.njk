---
title: "Videa z našich cest s jógou | IC Yoga Březnice"
description: "Videa z pobytů s jógou s Ivou Ceradskou: Norsko, Keňa, Ischia, Finsko, Gran Canaria, Azory, Bali, Vietnam, Madeira a další."
---
{% from "components/macros.njk" import titulek with context %}
{{ titulek("Videa z našich cest", "meditace-pri-zapadu-slunce", "Ochutnávka pobytů s jógou", "center 60%") }}

<section class="section" aria-labelledby="videa-nadpis">
  <div class="wrap">
    <h2 id="videa-nadpis" class="visually-hidden">Videa</h2>
    <p class="center lead">Video se načte z YouTube až po kliknutí na tlačítko přehrát (v režimu bez sledovacích cookies).</p>
    {%- if wp.videa.length %}
    <ul class="karty" role="list">
      {%- for v in wp.videa %}
      <li class="karta karta--video">
        {%- if v.youtube %}
        <div class="video" data-video="{{ v.youtube }}" data-title="{{ v.nazev }}">
          <img src="{{ v.obrazek or ('https://i.ytimg.com/vi/' + v.youtube + '/hqdefault.jpg') }}" alt="" loading="lazy" decoding="async" width="480" height="360">
          <button class="video__play" type="button"><span><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4l15 8-15 8z"/></svg></span><span class="visually-hidden">Přehrát video: {{ v.nazev }}</span></button>
        </div>
        {%- endif %}
        <div class="karta__telo">
          <h3 class="karta__nadpis karta__nadpis--maly">{{ v.nazev }}</h3>
          {% if not v.youtube %}<p><a href="{{ v.odkaz }}">Zobrazit video</a></p>{% endif %}
        </div>
      </li>
      {%- endfor %}
    </ul>
    {%- else %}
    <p class="center prazdne">Videa najdete na <a href="{{ wp.url }}/videa/">stránce s videi</a>.</p>
    {%- endif %}
    <div class="center tlacitka"><a class="btn btn--plny" href="pobyty.html">Aktuální pobyty</a></div>
  </div>
</section>
