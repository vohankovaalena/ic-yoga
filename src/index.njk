---
title: "Jóga Březnice | IC Yoga – lekce jógy s Ivou Ceradskou"
description: "Lekce jógy v Březnici: vinyasa, jin (yin), jin jang (yin yang), zdravá záda, dětská a teen jóga. Rozvrh, ceník a jak se zapsat. Kurzy a pobyty s jógou s lektorkou Ivou Ceradskou."
ogTitle: "IC Yoga Březnice – jóga pro tělo, mysl i duši"
---
{% from "components/macros.njk" import obrazek, oddelovac with context %}

{#- Hero: nekonečný carousel fotek. Pás se posouvá jen přes transform
    (plynule na grafické kartě), nadpis a tlačítka zůstávají na místě,
    citát se prolíná. Bez JavaScriptu zůstane první fotka s náhledem druhé. -#}
{%- set heroSnimky = [
  { foto: "iva-ceradska-joga-v-parku", alt: "Lektorka Iva Ceradská sedí na jógové podložce v parku a usmívá se", pozice: "35% 30%",
    citat: "Jóga vám umožní najít nový druh svobody, o které ani nevíte, že existovala.", autor: "B. K. S. Iyengar" },
  { foto: "iva-ceradska-pozice-v-prirode", alt: "Iva Ceradská v pozici bojovníka na kameni v lese", pozice: "50% 30%",
    citat: "Jóga neznamená jen stát na hlavě, ale naučit se postavit na vlastní nohy.", autor: "Swami Satchidananda" },
  { foto: "iva-ceradska-joga-v-lese", alt: "Iva Ceradská v jógové pozici na kameni v lese", pozice: "45% 35%",
    citat: "Jóga mění nejen způsob, kterým vidíme věci, ale transformuje člověka, který vidí.", autor: "B. K. S. Iyengar" }
] %}
<section class="hero" aria-labelledby="hero-nadpis" aria-roledescription="prezentace" data-hero>
  <ul class="hero__pas" role="list" data-hero-pas>
    {%- for s in heroSnimky %}
    <li class="hero__snimek{% if loop.first %} is-aktivni{% endif %}" aria-roledescription="snímek" aria-label="Fotka {{ loop.index }} ze {{ heroSnimky.length }}"{% if not loop.first %} aria-hidden="true"{% endif %}>
      <picture>
        <source type="image/webp" srcset="assets/img/{{ s.foto }}.webp">
        <img src="assets/img/{{ s.foto }}.jpg" alt="{{ s.alt }}" width="{{ obrazky[s.foto][0] }}" height="{{ obrazky[s.foto][1] }}" style="object-position: {{ s.pozice }}" decoding="async"{% if loop.first %} fetchpriority="high"{% else %} fetchpriority="low"{% endif %}>
      </picture>
    </li>
    {%- endfor %}
  </ul>

  <div class="hero__obsah" data-hero-zona>
    <p class="hero__nadtitulek">IC Yoga · Březnice</p>
    <h1 id="hero-nadpis">Jóga v Březnici pro dospělé, teenagery i&nbsp;děti</h1>
    <div class="hero__citaty">
      {%- for s in heroSnimky %}
      <blockquote class="hero__citat{% if loop.first %} is-aktivni{% endif %}" data-hero-citat{% if not loop.first %} aria-hidden="true"{% endif %}>
        <p>„{{ s.citat }}“</p>
        <footer>{{ s.autor }}</footer>
      </blockquote>
      {%- endfor %}
    </div>
    <div class="tlacitka">
      <a class="btn btn--plny" href="rozvrh.html">Rozvrh lekcí</a>
      <a class="btn btn--svetly" href="#jak-se-zapsat">Jak se zapsat</a>
    </div>
    <a class="hero__whatsapp" href="{{ site.whatsapp }}" target="_blank" rel="noopener">
      <span class="hero__whatsapp-ikona">{% include "components/ikona-whatsapp.njk" %}</span>
      <span>Novinky o akcích a pobytech najdete <span class="hero__whatsapp-odkaz">ve WhatsApp skupině</span><span class="visually-hidden"> (otevře se v novém okně)</span></span>
    </a>
  </div>

  <div class="hero__ovladani" data-hero-zona data-hero-ovladani hidden>
    <button class="hero__tlacitko" type="button" data-hero-predchozi><span class="visually-hidden">Předchozí fotka</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button>
    <div class="hero__tecky">
      {%- for s in heroSnimky %}
      <button class="hero__tecka{% if loop.first %} is-aktivni{% endif %}" type="button" data-hero-tecka><span class="visually-hidden">Fotka {{ loop.index }}</span><span class="hero__vypln" aria-hidden="true"></span></button>
      {%- endfor %}
    </div>
    <button class="hero__tlacitko" type="button" data-hero-dalsi><span class="visually-hidden">Další fotka</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button>
    <button class="hero__tlacitko" type="button" data-hero-pauza aria-pressed="false"><span class="visually-hidden" data-hero-pauza-text>Pozastavit prezentaci</span><svg class="ikona-pauza" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12" fill="none" stroke="currentColor" stroke-width="1.6"/></svg><svg class="ikona-prehrat" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5l11 6.5-11 6.5z" fill="currentColor"/></svg></button>
  </div>
</section>

<section class="section" aria-labelledby="lekce-nadpis">
  <div class="wrap">
    {{ oddelovac() }}
    <h2 id="lekce-nadpis" class="center nadpis-uzky">Jóga nám <em>otevírá</em> nový prostor, otevírá oči a učí nás správně vidět sebe i ostatní.</h2>
    <p class="center lead">Vyberte si lekci, která sedí vašemu tělu i náladě.</p>
    {% include "components/lekce-ikony.njk" %}
  </div>
</section>

{% include "components/jak-se-zapsat.njk" %}

<section class="section textura" aria-labelledby="omne-nadpis">
  <div class="wrap split">
    <div class="split__text">
      <h2 id="omne-nadpis">Jóga mi nasměrovala život</h2>
      <p>Jmenuji se Iva a moc ráda tvořím smysluplné věci a měním skrze jógu pohled svůj i ostatních tak, aby byli maximálně zdraví, šťastní a spokojení, sebejistí a v rovnováze fyzické i emoční.</p>
      <p>Jógu učím od roku 2004 – dospělé, děti i teenagery. Jsem certifikovaná lektorka se specializací na zdravá záda, dětskou a jinovou jógu.</p>
      <a class="btn btn--obrys" href="o-mne.html">Více o mně</a>
      <p class="velky-citat">Nabízím vám možnost hledat vnitřní klid a rovnováhu v propojení zdravého pohybu tak, abyste se cítili nejlépe, jak jenom můžete a sami sobě dovolíte.</p>
    </div>
    <div class="split__foto">
      {{ obrazek("iva-ceradska-pozice-orla", "Iva Ceradská v pozici orla na podložce na nádvoří zámku") }}
    </div>
  </div>
</section>

<section class="section" id="rozvrh" aria-labelledby="rozvrh-nadpis">
  <div class="wrap">
    {{ oddelovac() }}
    <h2 id="rozvrh-nadpis" class="center">Těším se <em>na</em> vás na těchto lekcích.</h2>
    {% include "components/rozvrh.njk" %}
    <p class="center poznamka">Kromě otevřených lekcí vypisuji i uzavřené <a href="kurzy.html">kurzy</a>. Ceny najdete v <a href="cenik.html">ceníku</a>.</p>
  </div>
</section>

{% include "components/recenze.njk" %}

<section class="banner-mandaly" aria-labelledby="studio-nadpis">
  {{ oddelovac("oddelovac--nahore") }}
  <div class="wrap center">
    <h2 id="studio-nadpis">V našem domě vznikl nový, prostorný jógový sál,<br> v&nbsp;němž <em>načerpáte množství</em> vjemů, zážitků i okamžiků poznání sebe i ostatních.</h2>
    <a class="btn btn--obrys" href="studio.html">Prohlédnout studio</a>
  </div>
</section>

<section class="section" aria-labelledby="faq-nadpis">
  <div class="wrap wrap--uzky">
    {{ oddelovac() }}
    <h2 id="faq-nadpis" class="center">Časté <em>dotazy</em></h2>
    {% include "components/faq.njk" %}
    <p class="center poznamka">Nenašli jste odpověď? <a href="tel:{{ site.telefonOdkaz }}">Zavolejte</a> nebo <a href="mailto:{{ site.email }}">napište</a>.</p>
  </div>
</section>

<section class="section instagram" aria-labelledby="ig-nadpis">
  <div class="wrap">
    <div class="instagram__hlavicka">
      <img src="assets/img/ic-yoga-logo.webp" alt="" width="392" height="366" loading="lazy">
      <div>
        <h2 id="ig-nadpis" class="h4"><a href="{{ site.instagram }}" rel="noopener" target="_blank">@{{ site.instagramJmeno }}<span class="visually-hidden"> na Instagramu (otevře se v novém okně)</span></a></h2>
        <p>Co je nového ve studiu i na cestách</p>
      </div>
    </div>
    <ul class="instagram__mrizka" role="list"{% if site.instagramFeed %} data-instagram-feed="{{ site.instagramFeed }}"{% endif %}>
      {%- if instagram.length %}
      {%- for p in instagram %}
      <li><a href="{{ p.odkaz }}" rel="noopener" target="_blank"><img src="{{ p.obrazek }}"{% if p.obrazek2x %} srcset="{{ p.obrazek }} 400w, {{ p.obrazek2x }} 700w" sizes="(max-width: 860px) 33vw, 200px"{% endif %} alt="{{ p.popis }} – zobrazit na Instagramu" width="400" height="400" loading="lazy" decoding="async"></a></li>
      {%- endfor %}
      {%- else %}
      {%- for f in [["studio-sal-podlozky", "Jógový sál s připravenými podložkami a pomůckami"], ["iva-ceradska-joga-na-plazi", "Iva Ceradská cvičí jógu na pláži"], ["iva-ceradska-meditace", "Iva Ceradská medituje u vody"], ["studio-logo-na-zdi", "Logo IC Yoga na zdi studia"], ["iva-ceradska-joga-v-lese", "Iva Ceradská v jógové pozici v lese"], ["meditace-pri-zapadu-slunce", "Meditace při západu slunce"]] %}
      <li><a href="{{ site.instagram }}" rel="noopener" target="_blank">{{ obrazek(f[0], f[1] + " – zobrazit Instagram IC Yoga") }}</a></li>
      {%- endfor %}
      {%- endif %}
    </ul>
    <div class="center"><a class="btn btn--plny" href="{{ site.instagram }}" rel="noopener" target="_blank">Sledovat na Instagramu<span class="visually-hidden"> (otevře se v novém okně)</span></a></div>
  </div>
</section>

{% include "components/kontakt.njk" %}
