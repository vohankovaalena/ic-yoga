{#- Slova klientů: tři ukázky vedle sebe a odkaz na nekonečný pás
    se všemi recenzemi na konci stránky O mně. Se `jenPobyty` ukáže
    jen recenze z pobytů (v recenze.json mají "pobyt": true). -#}
{% from "components/macros.njk" import oddelovac with context %}
{%- set vyber = recenze | selectattr("pobyt") if jenPobyty else recenze.slice(0, 3) %}
<section class="section recenze" aria-labelledby="recenze-nadpis">
  <div class="wrap">
    {{ oddelovac() }}
    <h2 id="recenze-nadpis" class="center">Není větší <em>vděčnosti,</em> než za slova<br> spokojených klientů.</h2>
    <ul class="recenze__mrizka" role="list">
      {%- for r in vyber %}
      <li class="recenze__karta">
        <figure>
          <img class="recenze__mandala" src="assets/ikony/mandala-kvet.svg" alt="" width="48" height="48">
          <blockquote><p>{{ r.text }}</p></blockquote>
          <figcaption>{{ r.autor }}</figcaption>
        </figure>
      </li>
      {%- endfor %}
    </ul>
    <div class="center tlacitka">
      <a class="btn btn--obrys" href="o-mne.html#recenze">Zobrazit více recenzí</a>
    </div>
  </div>
</section>
