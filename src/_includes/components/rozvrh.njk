{#- Týdenní rozvrh. Data skládá _data/rozvrh.js z lekce.json.
    Na širokém displeji tabulka (dny × hodiny), na mobilu seznam po dnech.
    Text se nikde neskrývá po najetí myší a barvy splňují kontrast WCAG AA. -#}
<div class="rozvrh">
  <table class="rozvrh__tabulka">
    <caption class="visually-hidden">Týdenní rozvrh otevřených lekcí jógy v IC Yoga Březnice</caption>
    <thead>
      <tr>
        <th scope="col"><span class="visually-hidden">Začátek lekce</span></th>
        {%- for den in rozvrh.dny %}
        <th scope="col">{{ den.nazev }}</th>
        {%- endfor %}
      </tr>
    </thead>
    <tbody>
      {%- for radek in rozvrh.radky %}
      <tr>
        <th scope="row">{{ radek.hodina }}</th>
        {%- for bunka in radek.bunky %}
        <td>
          {%- for t in bunka %}
          <a class="rozvrh__lekce rozvrh__lekce--{{ t.barva }}" href="{{ t.slug }}.html">
            <span class="rozvrh__nazev">{{ t.nazev }}</span>
            {% if t.pozn %}<span class="rozvrh__pozn">{{ t.pozn }}</span>{% endif %}
            <span class="rozvrh__cas"><time datetime="{{ t.od }}">{{ t.od | replace(":", ".") }}</time>–<time datetime="{{ t.do }}">{{ t.do | replace(":", ".") }}</time></span>
          </a>
          {%- endfor %}
        </td>
        {%- endfor %}
      </tr>
      {%- endfor %}
    </tbody>
  </table>

  <ul class="rozvrh__dny" role="list">
    {%- for den in rozvrh.dnySLekcemi %}
    <li class="rozvrh__den">
      <h3 class="rozvrh__den-nazev">{{ den.nazev }}</h3>
      <ul role="list">
        {%- for t in den.lekce %}
        <li><a class="rozvrh__lekce rozvrh__lekce--{{ t.barva }}" href="{{ t.slug }}.html"><span class="rozvrh__nazev">{{ t.nazev }}{% if t.pozn %} <span class="rozvrh__pozn">({{ t.pozn }})</span>{% endif %}</span> <span class="rozvrh__cas">{{ t.cas }}</span></a></li>
        {%- endfor %}
      </ul>
    </li>
    {%- endfor %}
  </ul>
</div>
